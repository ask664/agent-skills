{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "api-lookup script arguments",
  "type": "object",
  "properties": {
    "owner": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}$"
    }
  },
  "required": [
    "owner",
    "repository"
  ],
  "additionalProperties": false
}
